@model List<Product>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Tình hình kho"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">KHO HÀNG</div><h1>📦 Tình hình tồn kho</h1><p class="muted">Màn hình theo dõi dành cho nhân viên; chỉnh sửa tồn kho thực hiện ở khu vực quản trị.</p></div><a href="/admin/ton-kho" class="btn-ghost">Mở quản trị kho</a></div>
<form method="get" class="admin-filter"><input name="q" value="@ViewBag.Search" placeholder="Tìm sản phẩm..."/><label class="checkbox-label"><input type="checkbox" name="lowOnly" value="true" checked="@(ViewBag.LowOnly==true)"/><span>Chỉ hàng ít / hết hàng</span></label><button class="btn-primary">Lọc</button></form>
<div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Thương hiệu</th><th>Tồn kho</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><div class="product-cell">@if(!string.IsNullOrWhiteSpace(p.PrimaryImage)){<img src="@p.PrimaryImage" alt="@p.Name" style="width:48px;height:48px;object-fit:contain;background:#f7f7f8;border-radius:8px"/>}<strong>@p.Name</strong></div></td><td>@p.Category?.Name</td><td>@p.Brand?.Name</td><td><strong>@p.Stock</strong></td><td><span class="badge @(p.Stock<=0?"badge-danger":p.Stock<=5?"badge-warning":"badge-success")">@(p.Stock<=0?"Hết hàng":p.Stock<=5?"Sắp hết":"Đủ hàng")</span></td></tr>}</tbody></table></div></div></div>
