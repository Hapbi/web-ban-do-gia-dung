@model List<Order>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Xác minh thanh toán"; }
<div class="admin-dashboard">
  <div class="admin-header"><div><div class="eyebrow">BÁN HÀNG</div><h1>💳 Xác minh thanh toán</h1><p class="muted">@ViewBag.PendingCount đơn chuyển khoản đang chờ xác minh.</p></div><a class="btn-ghost" href="/admin/don-hang">Tất cả đơn hàng</a></div>
  <form method="get" class="admin-filter"><input name="q" value="@ViewBag.Search" placeholder="Tìm mã đơn, tên khách, số điện thoại..."/><label class="checkbox-label"><input type="checkbox" name="pendingOnly" value="true" checked="@(ViewBag.PendingOnly == true)"/><span>Chỉ đơn chờ xác minh</span></label><button class="btn-primary">Lọc</button></form>
  <div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Đơn hàng</th><th>Khách hàng</th><th>Ngày tạo</th><th>Tổng tiền</th><th>Chứng từ</th><th>Trạng thái</th><th>Xử lý</th></tr></thead><tbody>
  @foreach (var o in Model) { <tr><td><strong>#@o.Code</strong><div class="muted small">@o.Items.Count sản phẩm</div></td><td>@o.CustomerName<div class="muted small">@o.Phone</div></td><td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@o.Total.ToString("N0")đ</strong></td><td>@if (!string.IsNullOrWhiteSpace(o.PaymentProofUrl)) { <a href="@o.PaymentProofUrl" target="_blank" rel="noopener">Xem chứng từ ↗</a> } else { <span class="muted">Chưa đính kèm</span> }<div class="small muted">@o.PaymentNote</div></td><td><span class="badge @(o.Payment == PaymentStatus.Paid ? "badge-success" : o.Payment == PaymentStatus.Refunded ? "badge-danger" : "badge-warning")">@o.Payment.Label()</span></td><td><form method="post" action="/admin/thanh-toan/@o.Id/cap-nhat" class="stack-form"><input type="hidden" name="status" value="Paid"/><input name="note" value="@o.PaymentNote" placeholder="Ghi chú xử lý"/><button class="btn-small btn-success" type="submit">Xác nhận đã nhận tiền</button></form>@if (o.Payment == PaymentStatus.Paid) { <form method="post" action="/admin/thanh-toan/@o.Id/cap-nhat" class="stack-form"><input type="hidden" name="status" value="Refunded"/><input name="note" placeholder="Lý do hoàn tiền"/><button class="btn-small btn-danger" type="submit">Đánh dấu hoàn tiền</button></form> }</td></tr> }
  @if (!Model.Any()) { <tr><td colspan="7" class="muted" style="text-align:center;padding:32px">Không có đơn chuyển khoản phù hợp.</td></tr> }
  </tbody></table></div></div>
</div>
