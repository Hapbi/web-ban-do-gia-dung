@model AdminSettingsVM
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Cấu hình cửa hàng"; }
<div class="admin-dashboard">
 <div class="admin-header"><div><div class="eyebrow">HỆ THỐNG</div><h1>⚙️ Cấu hình cửa hàng</h1><p class="muted">Thông tin hiển thị, vận chuyển và tài khoản nhận chuyển khoản.</p></div></div>
 <div class="dash-grid-2">
  <form method="post" action="/admin/cau-hinh/cua-hang" class="dash-panel"><h3>🏪 Thông tin cửa hàng</h3>
   <div class="form-group"><label>Tên cửa hàng</label><input name="SiteName" value="@Model.Site.SiteName" required/></div><div class="form-group"><label>Slogan</label><input name="Tagline" value="@Model.Site.Tagline"/></div><div class="form-group"><label>Đường dẫn logo (nếu có)</label><input name="LogoUrl" value="@Model.Site.LogoUrl"/></div>
   <div class="form-row-2"><div class="form-group"><label>Điện thoại</label><input name="Phone" value="@Model.Site.Phone"/></div><div class="form-group"><label>Email hỗ trợ</label><input type="email" name="Email" value="@Model.Site.Email" required/></div></div><div class="form-group"><label>Địa chỉ</label><input name="Address" value="@Model.Site.Address"/></div><div class="form-group"><label>Giờ hoạt động</label><input name="OpenHours" value="@Model.Site.OpenHours"/></div>
   <div class="form-row-2"><div class="form-group"><label>Phí vận chuyển (đ)</label><input type="number" min="0" name="ShippingFee" value="@Model.Site.ShippingFee"/></div><div class="form-group"><label>Ngưỡng miễn phí ship (đ)</label><input type="number" min="0" name="FreeShipThreshold" value="@Model.Site.FreeShipThreshold"/></div></div>
   <div class="form-group"><label>Tỷ lệ phí nền tảng Marketplace (0–1, ví dụ 0.07)</label><input type="number" min="0" max="1" step="0.01" name="PlatformFeeRate" value="@Model.Site.PlatformFeeRate"/></div>
   <div class="form-row-2"><div class="form-group"><label>Facebook URL</label><input name="FacebookUrl" value="@Model.Site.FacebookUrl"/></div><div class="form-group"><label>YouTube URL</label><input name="YoutubeUrl" value="@Model.Site.YoutubeUrl"/></div></div><div class="form-group"><label>Zalo URL</label><input name="ZaloUrl" value="@Model.Site.ZaloUrl"/></div><button class="btn-primary">Lưu thông tin cửa hàng</button>
  </form>
  <form method="post" action="/admin/cau-hinh/ngan-hang" class="dash-panel"><h3>🏦 Nhận chuyển khoản</h3><div class="alert alert-warning">Chỉ nhập tài khoản ngân hàng thật của cửa hàng khi đã sẵn sàng nhận tiền. Không dùng thông tin mẫu.</div>
   <div class="form-group"><label>Tên ngân hàng</label><input name="BankName" value="@Model.Bank.BankName" required/></div><div class="form-row-2"><div class="form-group"><label>Số tài khoản</label><input name="AccountNumber" value="@Model.Bank.AccountNumber"/></div><div class="form-group"><label>Chủ tài khoản</label><input name="AccountHolder" value="@Model.Bank.AccountHolder"/></div></div><div class="form-group"><label>Chi nhánh</label><input name="Branch" value="@Model.Bank.Branch"/></div><div class="form-group"><label>URL ảnh QR (tùy chọn)</label><input name="QrImageUrl" value="@Model.Bank.QrImageUrl"/></div><div class="form-group"><label>Mẫu nội dung chuyển khoản</label><input name="TransferTemplate" value="@Model.Bank.TransferTemplate"/><p class="muted small">Có thể dùng {OrderCode} và {CustomerName}.</p></div><div class="form-group"><label>Hướng dẫn khách hàng</label><textarea name="Instructions" rows="4">@Model.Bank.Instructions</textarea></div><button class="btn-primary">Lưu cấu hình ngân hàng</button>
  </form>
 </div>
</div>
