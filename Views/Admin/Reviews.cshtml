@model List<Review>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Đánh giá"; }

<div class="admin-dashboard">
    <div class="admin-header"><div><h1>Quản lý đánh giá</h1></div></div>

    <div class="dash-panel">
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Sản phẩm</th><th>Người đánh giá</th><th>Rating</th><th>Tiêu đề</th><th>Nội dung</th><th>Trạng thái</th><th>Kiểm duyệt</th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Product?.Name</td>
                            <td>@r.User?.FullName</td>
                            <td>
                                <span class="stars">
                                    @for (int i = 1; i <= 5; i++) { <span class="@(i <= r.Rating ? "star-filled" : "star-empty")">★</span> }
                                </span>
                            </td>
                            <td>@r.Title</td>
                            <td class="truncate-cell">@r.Content</td>
                            <td>
                                @switch (r.Status)
                                {
                                    case ReviewStatus.Approved: <span class="badge badge-success">Đã duyệt</span>; break;
                                    case ReviewStatus.Pending: <span class="badge badge-warning">Chờ duyệt</span>; break;
                                    default: <span class="badge badge-danger">Từ chối</span>; break;
                                }
                            </td>
                            <td>
                                @if (r.Status != ReviewStatus.Approved) { <form method="post" action="/admin/danh-gia/@r.Id/duyet"><button class="btn-small btn-success">Duyệt</button></form> }
                                @if (r.Status != ReviewStatus.Rejected) { <form method="post" action="/admin/danh-gia/@r.Id/tu-choi"><button class="btn-small btn-danger">Từ chối</button></form> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


