@model List<Product>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Marketplace"; }
<div class="admin-dashboard">
 <div class="admin-header"><div><div class="eyebrow">DUYỆT NỘI DUNG</div><h1>🛍️ Marketplace</h1><p class="muted">Kiểm duyệt sản phẩm do người dùng đăng bán.</p></div><span class="badge badge-warning">@Model.Count listing</span></div>
 <form method="get" class="admin-filter"><select name="status"><option value="">Tất cả trạng thái</option><option value="Pending" selected="@(ViewBag.Status?.ToString()=="Pending")">Chờ duyệt</option><option value="Approved" selected="@(ViewBag.Status?.ToString()=="Approved")">Đã duyệt</option><option value="Rejected" selected="@(ViewBag.Status?.ToString()=="Rejected")">Từ chối</option></select><button class="btn-primary">Lọc</button></form>
 <div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Người đăng</th><th>Danh mục</th><th>Giá / Tồn</th><th>Phí nền tảng</th><th>Trạng thái</th><th>Kiểm duyệt</th></tr></thead><tbody>
 @foreach (var p in Model) { <tr><td><div class="product-cell">@if(!string.IsNullOrWhiteSpace(p.PrimaryImage)){<img src="@p.PrimaryImage" alt="@p.Name" style="width:56px;height:56px;object-fit:contain;border-radius:10px;background:#f6f7f9"/>}<div><strong>@p.Name</strong><div class="muted small">@p.Brand?.Name</div><div class="muted small">@p.RejectReason</div></div></div></td><td>@(p.Owner?.FullName ?? "Tài khoản cửa hàng")<div class="muted small">@p.Owner?.Email</div></td><td>@p.Category?.Name</td><td>@p.CurrentPrice.ToString("N0")đ<div class="muted small">Tồn: @p.Stock</div></td><td>@((p.PlatformFeeRate * 100m).ToString("0.#"))%</td><td>@p.ListingStatus.Label()</td><td>@if(p.ListingStatus != ListingStatus.Approved){<form method="post" action="/admin/marketplace/@p.Id/duyet"><button class="btn-small btn-success">Duyệt</button></form>}<form method="post" action="/admin/marketplace/@p.Id/tu-choi" class="stack-form"><input name="reason" required placeholder="Lý do từ chối"/><button class="btn-small btn-danger">Từ chối</button></form></td></tr> }
 @if(!Model.Any()){<tr><td colspan="7" class="muted" style="text-align:center;padding:30px">Chưa có listing Marketplace.</td></tr>}
 </tbody></table></div></div>
</div>
