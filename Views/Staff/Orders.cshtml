@model List<Order>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Đơn hàng"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">VẬN HÀNH</div><h1>🧾 Quản lý đơn hàng</h1><p class="muted">Tìm kiếm và mở chi tiết để xử lý theo đúng bước.</p></div><div style="display:flex;gap:.6rem;flex-wrap:wrap"><a href="@Url.Action("ExportOrdersCsv", "Staff", new { status = ViewBag.Status, q = ViewBag.Search })" class="btn-ghost">⬇ Xuất CSV</a><a href="/staff/kanban" class="btn-primary">Mở Kanban →</a></div></div>
<form method="get" class="admin-filter"><input name="q" value="@ViewBag.Search" placeholder="Mã đơn, tên khách, số điện thoại..."/><select name="status"><option value="">Tất cả trạng thái</option>@foreach(OrderStatus st in Enum.GetValues(typeof(OrderStatus))){<option value="@st" selected="@(ViewBag.Status?.ToString()==st.ToString())">@st.Label()</option>}</select><button class="btn-primary">Lọc</button></form>
<div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Sản phẩm</th><th>Tổng</th><th>Thanh toán</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td><strong>#@o.Code</strong><div class="muted small">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></td><td>@o.CustomerName<div class="muted small">@o.Phone</div></td><td>@o.Items.Sum(i=>i.Quantity) món</td><td><strong>@o.Total.ToString("N0")đ</strong></td><td>@o.Payment.Label()<div class="muted small">@o.PaymentMethod.Label()</div></td><td>@o.Status.Label()</td><td><a class="btn-small btn-primary" href="/staff/don-hang/@o.Id">Chi tiết</a></td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="muted" style="text-align:center;padding:30px">Không có đơn hàng phù hợp.</td></tr>}</tbody></table></div></div></div>
