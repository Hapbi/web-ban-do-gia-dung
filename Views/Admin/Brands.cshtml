@model List<Brand>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Thương hiệu"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">DANH MỤC SẢN PHẨM</div><h1>🏷️ Quản lý thương hiệu</h1><p class="muted">Thương hiệu có sản phẩm gắn vào sẽ được ẩn thay vì xóa cứng.</p></div></div>
<div class="dash-panel"><h3>Thêm thương hiệu</h3><form method="post" action="/admin/thuong-hieu/luu" class="admin-filter"><input name="name" required placeholder="Tên thương hiệu"/><button class="btn-primary">Thêm</button></form></div>
<div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Tên</th><th>Slug</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><form method="post" action="/admin/thuong-hieu/luu" class="inline-edit"><input type="hidden" name="id" value="@b.Id"/><input name="name" value="@b.Name" required/><button class="btn-small btn-primary">Lưu</button></form></td><td class="muted">@b.Slug</td><td><span class="badge @(b.IsActive?"badge-success":"badge-danger")">@(b.IsActive?"Đang hiện":"Đã ẩn")</span></td><td><form method="post" action="/admin/thuong-hieu/@b.Id/an-hien"><button class="link-secondary">@(b.IsActive?"Ẩn":"Hiện")</button></form></td></tr>}</tbody></table></div></div></div>
