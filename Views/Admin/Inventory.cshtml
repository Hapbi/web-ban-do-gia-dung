@model List<Product>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Quản lý tồn kho"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">KHO HÀNG</div><h1>📦 Quản lý tồn kho</h1><p class="muted">Điều chỉnh bằng số lượng tăng/giảm; không cho tồn kho âm. Mọi chỉnh sửa sẽ có nhật ký.</p></div></div>
<form method="get" class="admin-filter"><input name="q" value="@ViewBag.Search" placeholder="Tìm sản phẩm..."/><label class="checkbox-label"><input type="checkbox" name="lowOnly" value="true" checked="@(ViewBag.LowOnly==true)"/><span>Chỉ hàng sắp hết / hết hàng</span></label><button class="btn-primary">Lọc</button></form>
<div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá</th><th>Tồn hiện tại</th><th>Điều chỉnh</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><div class="product-cell">@if(!string.IsNullOrWhiteSpace(p.PrimaryImage)){<img src="@p.PrimaryImage" alt="@p.Name" style="width:52px;height:52px;object-fit:contain;background:#f7f7f8;border-radius:10px"/>}<div><strong>@p.Name</strong><div class="muted small">@p.Brand?.Name · SKU #@p.Id</div></div></div></td><td>@p.Category?.Name</td><td>@p.CurrentPrice.ToString("N0")đ</td><td><span class="badge @(p.Stock<=0?"badge-danger":p.Stock<=5?"badge-warning":"badge-success")">@p.Stock</span></td><td><form method="post" action="/admin/ton-kho/@p.Id/dieu-chinh" class="stock-adjust"><input name="delta" type="number" value="1" min="-100000" max="100000" required/><input name="note" placeholder="Lý do (nhập hàng, kiểm kê...)"/><button class="btn-small btn-primary">Cập nhật</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="muted" style="text-align:center;padding:30px">Không tìm thấy sản phẩm.</td></tr>}</tbody></table></div></div></div>
