@model OperationsReportVM
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Báo cáo vận hành"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">BÁO CÁO NGÀY</div><h1>📈 Vận hành · @Model.Date.ToString("dd/MM/yyyy")</h1><p class="muted">Các điểm cần ưu tiên xử lý trong hoạt động cửa hàng.</p></div><a class="btn-ghost" href="/admin/bao-cao/doanh-thu">Báo cáo doanh thu →</a></div>
<div class="stat-grid"><div class="stat-card-new stat-blue"><div class="stat-top">Đơn hôm nay</div><div class="stat-value">@Model.OrdersToday</div></div><div class="stat-card-new stat-purple"><div class="stat-top">Đơn 7 ngày</div><div class="stat-value">@Model.OrdersWeek</div></div><div class="stat-card-new stat-amber"><div class="stat-top">Chờ xác nhận</div><div class="stat-value">@Model.PendingOrders</div></div><div class="stat-card-new stat-red"><div class="stat-top">Chờ xác minh tiền</div><div class="stat-value">@Model.PendingPayments</div></div><div class="stat-card-new stat-green"><div class="stat-top">Hàng sắp hết</div><div class="stat-value">@Model.LowStockProducts</div></div><div class="stat-card-new stat-red"><div class="stat-top">Hết hàng</div><div class="stat-value">@Model.OutStockProducts</div></div><div class="stat-card-new stat-purple"><div class="stat-top">Tin nhắn mới</div><div class="stat-value">@Model.NewContacts</div></div><div class="stat-card-new stat-amber"><div class="stat-top">Marketplace chờ duyệt</div><div class="stat-value">@Model.NewListings</div></div></div>
<div class="dash-grid-2"><div class="dash-panel"><h3>💳 Đơn chờ xác minh thanh toán</h3>@foreach(var o in Model.PendingPaymentOrders){<div class="pending-order-row"><div><strong>#@o.Code</strong><div class="muted small">@o.CustomerName · @o.CreatedAt.ToString("dd/MM HH:mm")</div></div><strong>@o.Total.ToString("N0")đ</strong><a class="link-secondary" href="/admin/don-hang/@o.Id">Chi tiết</a></div>}@if(!Model.PendingPaymentOrders.Any()){<p class="muted">Không có đơn chờ xác minh.</p>}<a href="/admin/thanh-toan" class="btn-ghost">Mở hàng đợi thanh toán</a></div>
<div class="dash-panel"><h3>⏳ Đơn chờ trên 24 giờ</h3>@foreach(var o in Model.OldPendingList){<div class="pending-order-row"><div><strong>#@o.Code</strong><div class="muted small">@o.CustomerName</div></div><span class="muted">@((DateTime.Now-o.CreatedAt).TotalHours.ToString("0")) giờ</span><a class="link-secondary" href="/admin/don-hang/@o.Id">Xem</a></div>}@if(!Model.OldPendingList.Any()){<p class="muted">Không có đơn quá hạn.</p>}</div></div>
<div class="dash-grid-2"><div class="dash-panel"><h3>⚠️ Sắp hết hàng</h3>@foreach(var p in Model.LowStockList){<div class="pending-order-row"><strong>@p.Name</strong><span class="badge badge-warning">Còn @p.Stock</span></div>}<a href="/admin/ton-kho?lowOnly=true" class="btn-ghost">Quản lý tồn kho</a></div><div class="dash-panel"><h3>🚫 Hết hàng</h3>@foreach(var p in Model.OutStockList){<div class="pending-order-row"><strong>@p.Name</strong><span class="badge badge-danger">0</span></div>}@if(!Model.OutStockList.Any()){<p class="muted">Không có sản phẩm hết hàng.</p>}</div></div></div>
