@model Order
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Đơn " + Model.Code; }

<div class="admin-dashboard">
    <div class="admin-header">
        <div>
            <a href="/admin/don-hang" class="back-link">← Danh sách</a>
            <h1>Đơn #@Model.Code</h1>
            <p class="muted">@Model.CustomerName · @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <span class="status-badge large status-@Model.Status.Color()">@Model.Status.Label()</span>
    </div>

    <div class="dash-grid-2">
        <div class="dash-panel">
            <h3>Thông tin giao hàng</h3>
            <div class="info-grid">
                <div><strong>Người nhận:</strong> @Model.CustomerName</div>
                <div><strong>SĐT:</strong> @Model.Phone</div>
                <div><strong>Email:</strong> @Model.Email</div>
                <div><strong>Địa chỉ:</strong> @Model.Address</div>
                @if (!string.IsNullOrEmpty(Model.Note)) { <div><strong>Ghi chú:</strong> @Model.Note</div> }
            </div>

            <h3 style="margin-top:2rem">Sản phẩm</h3>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>Sản phẩm</th><th>Giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr>
                                <td>@i.ProductName</td>
                                <td>@i.UnitPrice.ToString("N0")đ</td>
                                <td>@i.Quantity</td>
                                <td><strong>@i.LineTotal.ToString("N0")đ</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <div class="dash-panel">
                <h3>Thanh toán</h3>
                <div class="summary-rows">
                    <div class="summary-row"><span>Tạm tính</span><strong>@Model.Subtotal.ToString("N0")đ</strong></div>
                    @if (Model.Discount > 0) { <div class="summary-row"><span>Giảm giá</span><strong>−@Model.Discount.ToString("N0")đ</strong></div> }
                    <div class="summary-row"><span>Vận chuyển</span><strong>@(Model.Shipping == 0 ? "Miễn phí" : Model.Shipping.ToString("N0") + "đ")</strong></div>
                    <div class="summary-row summary-total"><span>Tổng</span><strong>@Model.Total.ToString("N0")đ</strong></div>
                </div>
                <div class="info-grid" style="margin-top:1rem">
                    <div><strong>Phương thức:</strong> @Model.PaymentMethod.Label()</div>
                    <div><strong>Trạng thái:</strong> @Model.Payment.Label()</div>
                    <div><strong>Mã vận đơn:</strong> @(Model.TrackingNumber ?? "Chưa cập nhật")</div>
                    @if (!string.IsNullOrWhiteSpace(Model.PaymentProofUrl)) { <div><strong>Chứng từ:</strong> <a href="@Model.PaymentProofUrl" target="_blank" rel="noopener">Mở chứng từ ↗</a></div> }
                    @if (!string.IsNullOrWhiteSpace(Model.PaymentNote)) { <div><strong>Ghi chú thanh toán:</strong> @Model.PaymentNote</div> }
                </div>
                <form method="post" action="/admin/don-hang/@Model.Id/van-don" class="stack-form" style="margin-top:1rem">
                    <label>Mã vận đơn</label><input name="trackingNumber" value="@Model.TrackingNumber" placeholder="Mã do đơn vị vận chuyển cấp" />
                    <button class="btn-primary">Lưu mã vận đơn</button>
                </form>
            </div>

            <div class="dash-panel">
                <h3>Lịch sử trạng thái</h3>
                <ol class="timeline">
                    @foreach (var h in Model.History.OrderBy(h => h.CreatedAt))
                    {
                        <li>
                            <strong>@h.Status.Label()</strong>
                            <div class="muted small">@h.CreatedAt.ToString("dd/MM HH:mm") · @h.ChangedBy</div>
                            @if (!string.IsNullOrEmpty(h.Note)) { <div class="small">@h.Note</div> }
                        </li>
                    }
                </ol>
            </div>
        </div>
    </div>
</div>


