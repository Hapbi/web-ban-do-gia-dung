@model List<Coupon>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Mã giảm giá"; }

<div class="admin-dashboard">
    <div class="admin-header"><div><h1>Mã giảm giá</h1></div></div>

    <div class="dash-grid-2">
        <div class="dash-panel">
            <h3>Thêm mã giảm giá</h3>
            <form method="post" action="/admin/ma-giam-gia/them">
                <div class="form-row-2">
                    <div class="form-group"><label>Mã</label><input name="Code" required placeholder="WELCOME10" /></div>
                    <div class="form-group"><label>Mô tả</label><input name="Description" /></div>
                    <div class="form-group">
                        <label>Loại</label>
                        <select name="Type">
                            <option value="0">Phần trăm (%)</option>
                            <option value="1">Số tiền (đ)</option>
                        </select>
                    </div>
                    <div class="form-group"><label>Giá trị</label><input name="Value" type="number" step="0.01" required /></div>
                    <div class="form-group"><label>Đơn tối thiểu</label><input name="MinOrderAmount" type="number" value="0" /></div>
                    <div class="form-group"><label>Giảm tối đa (nếu %)</label><input name="MaxDiscount" type="number" /></div>
                    <div class="form-group"><label>Bắt đầu</label><input name="StartDate" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
                    <div class="form-group"><label>Kết thúc</label><input name="EndDate" type="date" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" /></div>
                    <div class="form-group"><label>Giới hạn lượt dùng</label><input name="UsageLimit" type="number" value="0" /></div>
                </div>
                <label class="checkbox-label"><input type="checkbox" name="IsActive" value="true" checked /><span>Kích hoạt</span></label>
                <button type="submit" class="btn-primary">Thêm</button>
            </form>
        </div>

        <div class="dash-panel">
            <h3>Danh sách mã</h3>
            @foreach (var c in Model)
            {
                <div class="coupon-row">
                    <div>
                        <strong class="coupon-code">@c.Code</strong>
                        <div class="muted small">@c.Description</div>
                        <div class="small">
                            @if (c.Type == DiscountType.Percentage) { <span>Giảm @c.Value%</span> }
                            else { <span>Giảm @c.Value.ToString("N0")đ</span> }
                            · Đơn từ @c.MinOrderAmount.ToString("N0")đ
                            · Đã dùng @c.UsedCount/@(c.UsageLimit == 0 ? "∞" : c.UsageLimit.ToString())
                        </div>
                    </div>
                    <form method="post" action="/admin/ma-giam-gia/@c.Id/xoa" onsubmit="return confirm('Xóa mã?')">
                        <button type="submit" class="link-danger">Xóa</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>


