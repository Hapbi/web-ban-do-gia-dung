@model List<Banner>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Banner"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">TRANG CHỦ</div><h1>🖼️ Quản lý banner</h1><p class="muted">Dùng đường dẫn ảnh nội bộ như /images/banner.svg để website vẫn hiển thị khi ngoại tuyến.</p></div></div>
<div class="dash-panel"><h3>Thêm banner</h3><form method="post" action="/admin/banner/luu"><input type="hidden" name="id" value="0"/><div class="form-row-2"><div class="form-group"><label>Tiêu đề</label><input name="title" required/></div><div class="form-group"><label>Vị trí</label><select name="position"><option value="home-top">Trang chủ - trên</option><option value="home-middle">Trang chủ - giữa</option><option value="category-top">Đầu danh mục</option></select></div><div class="form-group"><label>Đường dẫn ảnh</label><input name="imageUrl" required placeholder="/images/products/fallback.svg"/></div><div class="form-group"><label>Liên kết khi nhấn</label><input name="linkUrl" placeholder="/san-pham"/></div><div class="form-group"><label>Thứ tự</label><input type="number" name="sortOrder" value="0"/></div></div><label class="checkbox-label"><input type="checkbox" name="isActive" value="true" checked/><span>Đang bật</span></label><div style="margin-top:1rem"><button class="btn-primary">Thêm banner</button></div></form></div>
<div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Ảnh</th><th>Thông tin</th><th>Vị trí</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var b in Model){<tr><td><img src="@b.ImageUrl" alt="@b.Title" style="width:140px;height:58px;object-fit:cover;border-radius:8px"/></td><td><strong>@b.Title</strong><div class="muted small">@b.LinkUrl</div><details><summary>Sửa</summary><form method="post" action="/admin/banner/luu" class="stack-form"><input type="hidden" name="id" value="@b.Id"/><input name="title" value="@b.Title" required/><input name="imageUrl" value="@b.ImageUrl" required/><input name="linkUrl" value="@b.LinkUrl"/><input name="position" value="@b.Position"/><input type="number" name="sortOrder" value="@b.SortOrder"/><label><input type="checkbox" name="isActive" value="true" checked="@b.IsActive"/> Đang bật</label><button class="btn-small btn-primary">Lưu</button></form></details></td><td>@b.Position</td><td>@b.SortOrder</td><td>@(b.IsActive?"Đang bật":"Đã tắt")</td><td><form method="post" action="/admin/banner/@b.Id/an-hien"><button class="link-secondary">@(b.IsActive?"Tắt":"Bật")</button></form></td></tr>}</tbody></table></div></div></div>
