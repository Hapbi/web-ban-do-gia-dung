@model RevenueReportVM
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Báo cáo doanh thu"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">DOANH THU & PHÂN TÍCH</div><h1>💹 Báo cáo doanh thu</h1><p class="muted">Doanh thu được tính từ đơn có trạng thái thanh toán đã nhận tiền.</p></div></div>
<div class="report-actions"><form method="get" class="admin-filter"><label>Từ ngày <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/></label><label>Đến ngày <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/></label><button class="btn-primary">Lọc khoảng ngày</button></form><a class="btn-ghost" href="@Url.Action("ExportRevenueCsv", "Admin", new { from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd") })">⬇ Xuất báo cáo CSV</a></div>
<div class="stat-grid"><div class="stat-card-new stat-green"><div class="stat-top">Doanh thu đã thu</div><div class="stat-value">@Model.TotalRevenue.ToString("N0")đ</div></div><div class="stat-card-new stat-blue"><div class="stat-top">Tổng đơn</div><div class="stat-value">@Model.TotalOrders</div></div><div class="stat-card-new stat-purple"><div class="stat-top">Đã thanh toán</div><div class="stat-value">@Model.PaidOrders</div></div><div class="stat-card-new stat-amber"><div class="stat-top">Giá trị TB/đơn đã trả</div><div class="stat-value">@Model.AvgOrderValue.ToString("N0")đ</div></div><div class="stat-card-new stat-blue"><div class="stat-top">Phí marketplace ước tính</div><div class="stat-value">@Model.PlatformFees.ToString("N0")đ</div></div><div class="stat-card-new stat-red"><div class="stat-top">Đơn đã hủy</div><div class="stat-value">@Model.CancelledOrders</div></div></div>
<div class="dash-panel"><h3>📊 Doanh thu theo ngày</h3><div class="report-bars">
@foreach (var d in Model.Daily)
{
    var pct = Model.MaxDailyRevenue <= 0 ? 0 : (double)(d.Revenue / Model.MaxDailyRevenue) * 100;
    var barWidth = pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";
    <div class="report-bar-row"><span>@d.Date.ToString("dd/MM")</span><div class="report-bar-track"><div class="report-bar-fill" style="width:@barWidth"></div></div><strong>@d.Revenue.ToString("N0")đ</strong><span class="muted small">@d.Orders đơn</span></div>
}
</div></div>
<div class="dash-grid-2"><div class="dash-panel"><h3>🏆 Sản phẩm bán chạy</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var p in Model.TopProducts){<tr><td>@p.ProductName</td><td>@p.Qty</td><td>@p.Revenue.ToString("N0")đ</td></tr>}@if(!Model.TopProducts.Any()){<tr><td colspan="3" class="muted">Chưa có dữ liệu.</td></tr>}</tbody></table></div></div><div class="dash-panel"><h3>🗂️ Doanh thu theo danh mục</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Danh mục</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var x in Model.ByCategory){<tr><td>@x.CategoryName</td><td>@x.Revenue.ToString("N0")đ</td></tr>}@if(!Model.ByCategory.Any()){<tr><td colspan="2" class="muted">Chưa có dữ liệu.</td></tr>}</tbody></table></div></div></div></div>
