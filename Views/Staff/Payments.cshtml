@model List<Order>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Xác minh thanh toán"; }
<div class="admin-dashboard"><div class="admin-header"><div><div class="eyebrow">CẦN QUYỀN XÁC MINH</div><h1>💳 Hàng đợi chuyển khoản</h1><p class="muted">Chỉ xác nhận sau khi kiểm tra giao dịch thực tế trên tài khoản ngân hàng.</p></div></div>
<form method="get" class="admin-filter"><input name="q" value="@ViewBag.Search" placeholder="Tìm mã đơn hoặc khách hàng..."/><button class="btn-primary">Tìm</button></form>
<div class="dash-panel"><div class="table-wrap"><table class="data-table"><thead><tr><th>Đơn / khách</th><th>Tổng tiền</th><th>Chứng từ</th><th>Ghi chú hiện tại</th><th>Xác minh</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><strong>#@o.Code</strong><div>@o.CustomerName</div><div class="muted small">@o.Phone · @o.CreatedAt.ToString("dd/MM HH:mm")</div></td><td><strong>@o.Total.ToString("N0")đ</strong></td><td>@if(!string.IsNullOrWhiteSpace(o.PaymentProofUrl)){<a href="@o.PaymentProofUrl" target="_blank" rel="noopener">Mở chứng từ ↗</a>}else{<span class="muted">Khách chưa gửi chứng từ</span>}</td><td>@o.PaymentNote</td><td><form method="post" action="/staff/thanh-toan/@o.Id/xac-minh" class="stack-form"><input name="note" placeholder="Ghi chú kiểm tra"/><button name="approved" value="true" class="btn-small btn-success">Xác nhận đã nhận</button><button name="approved" value="false" class="btn-small btn-danger">Chưa nhận / cần kiểm tra</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="muted" style="text-align:center;padding:30px">Không có khoản chuyển khoản đang chờ xác minh.</td></tr>}</tbody></table></div></div></div>
