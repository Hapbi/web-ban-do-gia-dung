@model List<SanPham>
@{ ViewBag.Title = "Quản lý sản phẩm"; }
<div class="admin-panel">
    <div class="panel-header">
        <h3>Danh sách sản phẩm (@ViewBag.TongSanPham)</h3>
        <a href="/quan-tri/san-pham/them" class="btn-primary">+ Thêm sản phẩm</a>
    </div>

    <form method="get" class="hang-cot">
        <input type="text" name="q" value="@ViewBag.Q" placeholder="Tìm theo tên..." />
        <button type="submit" class="btn-primary">Tìm</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Q as string)) { <a href="/quan-tri/san-pham" class="nut-phu">Xoá lọc</a> }
    </form>

    <div style="overflow-x:auto">
        <table class="table-glass mt-3">
            <thead>
                <tr><th>Ảnh</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn</th><th>Đã bán</th><th>Trạng thái</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
                @foreach (var sp in Model)
                {
                    <tr>
                        <td><img src="@(string.IsNullOrWhiteSpace(sp.AnhChinh) ? "/HinhAnh/anh-mac-dinh.svg" : sp.AnhChinh)"
                                 style="width:52px;height:52px;object-fit:cover;border-radius:8px"
                                 onerror="this.onerror=null;this.src='/HinhAnh/anh-mac-dinh.svg'" /></td>
                        <td><strong>@sp.Ten</strong></td>
                        <td>@sp.DanhMuc?.Ten</td>
                        <td>@TienIch.Tien(sp.GiaHienTai)</td>
                        <td>@sp.TonKho</td>
                        <td>@sp.DaBan</td>
                        <td>
                            @if (sp.DangBan) { <span class="badge-success">Đang bán</span> }
                            else { <span class="badge-warning">Đã ẩn</span> }
                        </td>
                        <td style="white-space:nowrap">
                            <a href="/quan-tri/san-pham/@sp.Id/sua" class="btn-primary" style="padding:6px 12px;font-size:12px">Sửa</a>
                            <form method="post" action="/quan-tri/san-pham/@sp.Id/hien" style="display:inline">
            @Html.AntiForgeryToken()
                                <button type="submit" class="nut-phu" style="padding:6px 12px;font-size:12px">@(sp.DangBan ? "Ẩn" : "Hiện")</button>
                            </form>
                            <form method="post" action="/quan-tri/san-pham/@sp.Id/xoa" style="display:inline" onsubmit="return confirm('Ẩn sản phẩm này?')">
            @Html.AntiForgeryToken()
                                <button type="submit" class="nut-nguy-hiem" style="padding:6px 12px;font-size:12px">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if ((int)(ViewBag.TongSoTrang ?? 1) > 1)
    {
        <nav class="phan-trang" aria-label="Phân trang quản lý sản phẩm">
            @if ((int)ViewBag.TrangHienTai > 1)
            {
                <a href="@Url.Action("SanPham", "QuanTri", new { q = ViewBag.Q, trang = (int)ViewBag.TrangHienTai - 1 })">‹ Trước</a>
            }
            <span>Trang @ViewBag.TrangHienTai / @ViewBag.TongSoTrang</span>
            @if ((int)ViewBag.TrangHienTai < (int)ViewBag.TongSoTrang)
            {
                <a href="@Url.Action("SanPham", "QuanTri", new { q = ViewBag.Q, trang = (int)ViewBag.TrangHienTai + 1 })">Sau ›</a>
            }
        </nav>
    }
</div>
