@model Order
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Đơn " + Model.Code; var nextAction = Model.Status switch { OrderStatus.Pending => "xac-nhan", OrderStatus.Confirmed => "dong-goi", OrderStatus.Packing => "giao", OrderStatus.Shipping => "giao-xong", _ => "" }; var nextLabel = Model.Status switch { OrderStatus.Pending => "Xác nhận đơn", OrderStatus.Confirmed => "Bắt đầu đóng gói", OrderStatus.Packing => "Bàn giao vận chuyển", OrderStatus.Shipping => "Xác nhận đã giao", _ => "Đơn đã kết thúc" }; }
<div class="admin-dashboard"><div class="admin-header"><div><a href="/staff/don-hang" class="back-link">← Danh sách đơn hàng</a><h1>Đơn #@Model.Code</h1><p class="muted">@Model.CustomerName · @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p></div><span class="status-badge large status-@Model.Status.Color()">@Model.Status.Label()</span></div>
<div class="dash-grid-2"><div class="dash-panel"><h3>🚚 Thông tin giao hàng</h3><div class="info-grid"><div><strong>Người nhận:</strong> @Model.CustomerName</div><div><strong>SĐT:</strong> @Model.Phone</div><div><strong>Email:</strong> @Model.Email</div><div><strong>Địa chỉ:</strong> @Model.Address</div><div><strong>Ghi chú:</strong> @Model.Note</div><div><strong>Mã vận đơn:</strong> @(Model.TrackingNumber ?? "Chưa có")</div></div><h3 style="margin-top:2rem">Sản phẩm</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.ProductName</td><td>@i.Quantity</td><td>@i.UnitPrice.ToString("N0")đ</td><td>@i.LineTotal.ToString("N0")đ</td></tr>}</tbody></table></div><form method="post" action="/staff/don-hang/@Model.Id/van-don" class="stack-form" style="margin-top:1rem"><label>Mã vận đơn</label><input name="trackingNumber" value="@Model.TrackingNumber" placeholder="Nhập mã vận đơn từ đơn vị vận chuyển"/><button class="btn-primary">Lưu mã vận đơn</button></form></div>
<div><div class="dash-panel"><h3>💳 Tổng kết</h3><div class="summary-rows"><div class="summary-row"><span>Tạm tính</span><strong>@Model.Subtotal.ToString("N0")đ</strong></div><div class="summary-row"><span>Giảm giá</span><strong>−@Model.Discount.ToString("N0")đ</strong></div><div class="summary-row"><span>Vận chuyển</span><strong>@Model.Shipping.ToString("N0")đ</strong></div><div class="summary-row summary-total"><span>Tổng</span><strong>@Model.Total.ToString("N0")đ</strong></div></div><p><strong>Thanh toán:</strong> @Model.Payment.Label()</p><p><strong>Phương thức:</strong> @Model.PaymentMethod.Label()</p>@if(Model.Status is not OrderStatus.Delivered and not OrderStatus.Cancelled and not OrderStatus.Returned){<form method="post" action="/staff/don/@Model.Id/@nextAction"><button class="btn-primary" style="width:100%">@nextLabel →</button></form>@if(Model.Status is OrderStatus.Pending or OrderStatus.Confirmed or OrderStatus.Packing){<form method="post" action="/staff/don/@Model.Id/huy" style="margin-top:.5rem"><button class="btn-ghost" style="width:100%">Hủy đơn / hoàn kho</button></form>}}</div>
<div class="dash-panel"><h3>🕒 Lịch sử xử lý</h3><ol class="timeline">@foreach(var h in Model.History.OrderBy(h=>h.CreatedAt)){<li><strong>@h.Status.Label()</strong><div class="muted small">@h.CreatedAt.ToString("dd/MM HH:mm") · @h.ChangedBy</div>@if(!string.IsNullOrWhiteSpace(h.Note)){<div class="small">@h.Note</div>}</li>}</ol></div></div></div></div>
